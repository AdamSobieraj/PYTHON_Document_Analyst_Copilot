# --- workflow tuning ---
MAX_ITERATIONS=3
LOW_CONFIDENCE_THRESHOLD=0.6

RAG_DEFAULT_MCP_TRANSPORT=streamable_http
RAG_DEFAULT_MCP_URL=http://rag-default:8000/mcp
# Tool name as exposed by the MCP server (the native server exposes
# ``query_knowledge_base``).
RAG_DEFAULT_MCP_TOOL=query_knowledge_base
RAG_DEFAULT_MCP_TOKEN=
RAG_DEFAULT_MCP_TIMEOUT=30
RAG_DEFAULT_MCP_TOP_K=5
# Knowledge-base collection (e.g. Qdrant) the tool searches; empty = the
# tool uses its own default. Only needed by tools that require one.
RAG_DEFAULT_MCP_COLLECTION=

RAG_ISO20022_MCP_TRANSPORT=streamable_http
RAG_ISO20022_MCP_URL=http://rag-iso20022:8000/mcp
RAG_ISO20022_MCP_TOOL=query_knowledge_base
RAG_ISO20022_MCP_TOKEN=
RAG_ISO20022_MCP_TIMEOUT=30
RAG_ISO20022_MCP_TOP_K=5
# ISO 20022 knowledge base, e.g. RAG_ISO20022_MCP_COLLECTION=iso20022_business
RAG_ISO20022_MCP_COLLECTION=

RAG_ISO8583_MCP_TRANSPORT=streamable_http
RAG_ISO8583_MCP_URL=http://rag-iso8583:8000/mcp
RAG_ISO8583_MCP_TOOL=query_knowledge_base
RAG_ISO8583_MCP_TOKEN=
RAG_ISO8583_MCP_TIMEOUT=30
RAG_ISO8583_MCP_TOP_K=5
RAG_ISO8583_MCP_COLLECTION=

JIRA_MCP_TRANSPORT=streamable_http
JIRA_MCP_URL=http://jira-mcp-service:8000/mcp
JIRA_MCP_TOOL=jira_search
JIRA_MCP_TOKEN=
JIRA_MCP_TIMEOUT=30
JIRA_MCP_TOP_K=5

CONFLUENCE_MCP_TRANSPORT=streamable_http
CONFLUENCE_MCP_URL=http://confluence-mcp-service:8000/mcp
CONFLUENCE_MCP_TOOL=confluence_search
CONFLUENCE_MCP_TOKEN=
CONFLUENCE_MCP_TIMEOUT=30
CONFLUENCE_MCP_TOP_K=5

# --- MCP availability (worker side) ---
# How often (seconds) the worker re-checks MCP servers that are not
# connected yet; 0 disables the background checks.
MCP_AVAILABILITY_CHECK_INTERVAL=60
# Timeout (seconds) of the one-shot reconnect probe made before answering
# when no MCP server is connected.
MCP_PROBE_TIMEOUT=5

LLM_BASE_URL=http://llm-service:8000/v1
LLM_API_KEY=
LLM_MODEL=bank-llm
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=
# Retry budget for transient LLM failures (429 / 5xx / timeouts), with backoff.
LLM_MAX_RETRIES=3

# --- Langfuse (tracing / monitoring) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-iso-insight
LANGFUSE_SECRET_KEY=sk-lf-iso-insight

# --- Celery / Redis broker (async queries) ---
# 6380 on the host: 6379 is already used by the Langfuse redis in docker-compose.
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_TASK_RESULT_EXPIRES=86400
CELERY_TASK_SOFT_TIME_LIMIT=2400
CELERY_TASK_TIME_LIMIT=2700
